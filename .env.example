# ─────────────────────────────────────────────────────────────
# Momentor — Environment Variables
# Copy this file to .env.local (gitignored) and fill in real values.
# Production values are configured in Vercel dashboard.
# ─────────────────────────────────────────────────────────────

# LemonSqueezy API key — https://app.lemonsqueezy.com/settings/api
# Used by api/verify-order.js to confirm paid orders.
LS_API_KEY=

# HMAC secret used to sign client-side access tokens after purchase.
# Any random long string (>=32 chars). Rotate if leaked.
LS_TOKEN_SECRET=

# Optional — GeoNames username for city search
# GEONAMES_USERNAME=
